{
  "name": "posthog-benchmark-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3322",
    "build": "next build",
    "start": "next start -p 3322",
    "eval": "mkdir -p evals/eval_runs evals/.promptfoo-data && ENV_FILE_ARGS='' && if [ -f .env.local ]; then ENV_FILE_ARGS='--env-file .env.local'; fi && PROMPTFOO_CONFIG_DIR=evals/.promptfoo-data PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/posthog_smoke.yaml $ENV_FILE_ARGS --output evals/eval_runs/latest.json evals/eval_runs/latest.html --table --no-cache --no-share --max-concurrency 3",
    "eval:ci": "mkdir -p evals/eval_runs evals/.promptfoo-data && ENV_FILE_ARGS='' && if [ -f .env.local ]; then ENV_FILE_ARGS='--env-file .env.local'; fi && PROMPTFOO_CONFIG_DIR=evals/.promptfoo-data PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval -c evals/posthog_smoke.yaml $ENV_FILE_ARGS --output evals/eval_runs/latest.json --no-table --no-cache --no-share --max-concurrency 3",
    "eval:realworld": "node scripts/run-eval-suite.mjs --config evals/posthog_realworld.yaml --label realworld --max-concurrency 1 --grader openai:gpt-4.1-mini",
    "eval:realworld:smoke": "node scripts/run-eval-suite.mjs --config evals/posthog_realworld.yaml --label realworld-smoke --filter-first-n 1 --max-concurrency 1 --grader openai:gpt-4.1-mini",
    "eval:realworld:ci": "node scripts/run-eval-suite.mjs --config evals/posthog_realworld.yaml --label realworld --max-concurrency 1 --grader openai:gpt-4.1-mini",
    "eval:stats": "node scripts/generate-eval-stats.mjs --stats",
    "truth": "node scripts/generate-ground-truth.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.55",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@posthog/cli": "^0.7.30",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ai": "^6.0.172",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "mcp-remote": "^0.1.38",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.1"
  },
  "overrides": {
    "axios": "1.15.2",
    "brace-expansion": "5.0.5",
    "follow-redirects": "1.16.0",
    "minimatch": "10.2.5",
    "postcss": "8.5.13",
    "@posthog/cli": {
      "axios": "1.15.2",
      "brace-expansion": "5.0.5",
      "follow-redirects": "1.16.0",
      "minimatch": "10.2.5"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "promptfoo": "^0.121.9",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
